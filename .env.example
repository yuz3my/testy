# Supabase (Settings -> API no dashboard do seu projeto)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord Developer Portal -> sua aplicação -> General Information
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Só usado localmente pra rodar `npm run register-commands` (não precisa ir pra Vercel)
DISCORD_BOT_TOKEN=
# Opcional: id de um servidor específico pra registrar o comando ali na hora, pra testar
DISCORD_GUILD_ID=
